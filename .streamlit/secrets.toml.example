# Copy this file to `secrets.toml` (same folder) and fill in your key.
# `secrets.toml` is gitignored - never commit a real key.
#
# On Streamlit Community Cloud, do NOT upload this file. Instead paste the
# same contents into:  app -> Settings -> Secrets.

GEMINI_API_KEY = "AIza-your-key-here"

# Only needed if you switch the Provider dropdown to Anthropic:
# ANTHROPIC_API_KEY = "sk-ant-your-key-here"
